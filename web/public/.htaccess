# o2switch (Apache) : tout passe par index.php sauf les fichiers existants
# La vitrine est un site à part (dépôt RuneRide/website)
# index.html d'abord : /app/ doit servir l'interface ; index.php reste le point d'entrée de l'API
DirectoryIndex index.html index.php
Options -Indexes
AddDefaultCharset UTF-8

# Types MIME de la PWA (au cas où le serveur ne les connaît pas)
AddType application/manifest+json .webmanifest
AddType text/javascript .js

RewriteEngine On

# app.runeride.fr : la racine renvoie vers l'interface (la vitrine vit sur runeride.fr)
RewriteRule ^$ /app/ [R=302,L]

# Interface web (PWA statique) : jamais envoyée vers index.php, y compris /app/ (répertoire)
RewriteRule ^app(/|$) - [L]

RewriteCond %{REQUEST_FILENAME} !-f
RewriteRule ^ index.php [L]

# Apache/FastCGI retire parfois l'en-tête Authorization : on le transmet à PHP
RewriteCond %{HTTP:Authorization} .
RewriteRule .* - [E=HTTP_AUTHORIZATION:%{HTTP:Authorization}]
