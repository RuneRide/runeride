# o2switch (Apache) : tout passe par index.php sauf les fichiers existants
RewriteEngine On
RewriteCond %{REQUEST_FILENAME} !-f
RewriteRule ^ index.php [L]

# Apache/FastCGI retire parfois l'en-tête Authorization : on le transmet à PHP
RewriteCond %{HTTP:Authorization} .
RewriteRule .* - [E=HTTP_AUTHORIZATION:%{HTTP:Authorization}]
