# o2switch (Apache) : tout passe par index.php sauf les fichiers existants
# La vitrine est un site à part (dépôt RuneRide/website)
# index.html d'abord : la racine sert l'interface ; index.php reste le point d'entrée de l'API
DirectoryIndex index.html index.php
Options -Indexes
AddDefaultCharset UTF-8

# Types MIME de la PWA (au cas où le serveur ne les connaît pas)
AddType application/manifest+json .webmanifest
AddType text/javascript .js

RewriteEngine On

# app.runeride.fr : l'interface (PWA) est à la racine. L'ancienne adresse /app/… est redirigée vers /…
# (sauf /app/sw.js : ancien service worker, qui se désinstalle seul).
RewriteRule ^app/sw\.js$ - [L]
RewriteRule ^app(?:/(.*))?$ /$1 [R=301,L]

RewriteCond %{REQUEST_FILENAME} !-f
RewriteRule ^ index.php [L]

# Apache/FastCGI retire parfois l'en-tête Authorization : on le transmet à PHP
RewriteCond %{HTTP:Authorization} .
RewriteRule .* - [E=HTTP_AUTHORIZATION:%{HTTP:Authorization}]
