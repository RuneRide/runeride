{
    "name": "runeride/runeride",
    "description": "Baseline gratuite de RuneRide : vitrine, comptes, API, trajets",
    "type": "project",
    "license": "EUPL-1.2",
    "require": {
        "php": ">=8.3",
        "ext-pdo": "*",
        "ext-openssl": "*"
    },
    "require-dev": {
        "phpunit/phpunit": "^11.0"
    },
    "autoload": { "psr-4": { "RuneRide\\": "src/" } },
    "autoload-dev": { "psr-4": { "RuneRide\\Tests\\": "tests/" } },
    "scripts": { "test": "phpunit", "serve": "php -S 127.0.0.1:8080 -t public" },
    "config": { "optimize-autoloader": true, "sort-packages": true }
}
