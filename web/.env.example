RUNERIDE_ENV=local
RUNERIDE_BASE_URL=http://127.0.0.1:8080
RUNERIDE_DB_DSN="mysql:host=127.0.0.1;dbname=runeride;charset=utf8mb4"
RUNERIDE_DB_USER=runeride
RUNERIDE_DB_PASSWORD=
RUNERIDE_JWT_KEY_FILE=storage/jwt-private.pem
RUNERIDE_JWT_AUDIENCE=runeride
# Connexion Google (laisser vide : désactivée). URI de redirection du client : RUNERIDE_BASE_URL + /api/google/retour
RUNERIDE_GOOGLE_CLIENT_ID=
RUNERIDE_GOOGLE_CLIENT_SECRET=
# Trajets GeoRide : clé de chiffrement des jetons d'accès GeoRide (32 octets en base64 : php -r 'echo base64_encode(random_bytes(32));')
RUNERIDE_GEORIDE_KEY=
RUNERIDE_GEORIDE_URL=https://api.georide.com
# Historique gratuit des trajets, en jours (au-delà : abonnés)
RUNERIDE_FREE_HISTORY_DAYS=30
# Calculateur de balade Raido (spec docs/itineraire.md §7.1) : audience et durée (s) du jeton court, adresse du service
# (vide : la PWA n'affiche pas la balade), paliers (D4 : petites boucles ≤ 25 km illimitées, 3 grands calculs par mois en gratuit)
RUNERIDE_RAIDO_AUDIENCE=raido
RUNERIDE_RAIDO_JETON_TTL=900
RUNERIDE_RAIDO_URL=
RUNERIDE_BALADE_LIMITE_KM=25
RUNERIDE_BALADE_GRANDS_PAR_MOIS=3
RUNERIDE_BALADE_ENREGISTREES_GRATUIT=5
